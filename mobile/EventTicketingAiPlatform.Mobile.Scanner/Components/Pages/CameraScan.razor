@page "/scan/camera"

@using System.Globalization
@using EventTicketingAiPlatform.Mobile.Scanner.Models
@using EventTicketingAiPlatform.Mobile.Scanner.Services
@using ZXing.Net.Maui
@using ZXing.Net.Maui.Controls
@inject ScannerApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <button class="icon-back" @onclick="() => Nav.NavigateTo(lhome)">
        ←
    </button>

    <div>
        <div class="page-kicker">Camera validation</div>
        <h2>Camera Scan</h2>
    </div>
</div>

<div class="card">
    <p class="muted">
        Point the camera at a ticket QR code or barcode.
    </p>

    <div class="card">
    <div class="camera-toolbar">
        <div>
            <p class="muted">Point the camera at a ticket QR code or barcode.</p>
            <strong>@ScanStatus</strong>
        </div>

        <label class="switch-row">
            <input type="checkbox" @bind="AutoValidate" />
            Auto
        </label>
    </div>

    <div class="camera-shell">
        <div class="camera-frame @(IsDetecting ? "scanning" : "paused")">
            <CameraBarcodeReaderView
                IsDetecting="@IsDetecting"
                BarcodesDetected="OnBarcodesDetected" />

            <div class="scan-corners"></div>
            <div class="scan-line"></div>
        </div>
    </div>
</div>
</div>

@if (!string.IsNullOrWhiteSpace(DetectedCode))
{
    <div class="card">
        <p><strong>Detected code:</strong></p>
        <h3>@DetectedCode</h3>

        <button class="btn btn-primary" disabled="@IsBusy" @onclick="ValidateDetectedAsync">
            @(IsBusy ? "Validating..." : "Validate detected ticket")
        </button>

        <button class="btn" @onclick="ResumeScanning">
            Scan another code
        </button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert error">@Error</div>
}

@if (Result is not null)
{
    <div class="card @(Result.Accepted ? "accepted" : "rejected")">
        <h3>@Result.Decision</h3>
        <p><strong>@Result.ReasonCode</strong></p>
        <p>@Result.Message</p>

        <p><strong>Risk:</strong> @Result.RiskScore/100 · @Result.RiskLevel</p>
        <p><strong>Recommended:</strong> @Result.RecommendedAction</p>

        @if (Result.RiskSignals.Count > 0)
        {
            <div class="chips">
                @foreach (var signal in Result.RiskSignals)
                {
                    <span>@signal</span>
                }
            </div>
        }
    </div>

    <div class="action-stack">
        <button class="btn btn-secondary" disabled="@IsLoadingRisk" @onclick="LoadRiskAsync">
            @(IsLoadingRisk ? "Loading AI..." : "Load AI Analysis")
        </button>

        <button class="btn btn-secondary" disabled="@IsLoadingAgent" @onclick="LoadAgentAsync">
            @(IsLoadingAgent ? "Loading Agent..." : "Analyze with Agent")
        </button>
    </div>
}

@if (Risk is not null)
{
    <div class="card risk">
        <h3>AI Risk Analysis</h3>

        <p><strong>Summary:</strong> @Risk.ExplanationSummary</p>
        <p><strong>Explanation:</strong> @Risk.RiskExplanation</p>
        <p><strong>Provider:</strong> @Risk.ExplanationProvider</p>
        <p><strong>Confidence:</strong> @Risk.ExplanationConfidence</p>
        <p><strong>Action:</strong> @Risk.RecommendedAction</p>
    </div>
}

@if (AgentDecision is not null)
{
    <div class="card agent-card">
        <h3>Agent Decision</h3>

        <p><strong>Severity:</strong> @AgentDecision.Severity</p>
        <p><strong>Reason:</strong> @AgentDecision.Reason</p>

        <p>
            <strong>Requires Review:</strong>
            @(AgentDecision.RequiresHumanReview ? "Yes" : "No")
        </p>

        @if (AgentDecision.Actions.Count > 0)
        {
            <div class="chips">
                @foreach (var action in AgentDecision.Actions)
                {
                    <span>@action</span>
                }
            </div>
        }
    </div>

    @if (AgentDecision.Enrichment is not null)
    {
        <div class="agent-enrichment">
            <div class="section-title">Agent V2 Enrichment</div>

            <p><strong>Summary:</strong> @AgentDecision.Enrichment.OperatorSummary</p>
            <p><strong>Business impact:</strong> @AgentDecision.Enrichment.BusinessImpact</p>
            <p><strong>Confidence:</strong> @AgentDecision.Enrichment.ConfidenceScore</p>
            <p><strong>Provider:</strong> @AgentDecision.Enrichment.Provider</p>

            @if (AgentDecision.Enrichment.SuggestedNextActions.Count > 0)
            {
                <p><strong>Suggested actions:</strong></p>

                <div class="chips">
                    @foreach (var action in AgentDecision.Enrichment.SuggestedNextActions)
                    {
                        <span>@action</span>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private string lhome = "/";

    private bool AutoValidate = true;
    private string ScanStatus = "Ready to scan";

    private string DeviceId = "MOBILE-CAMERA-01";
    private string GateId = "GATE-MOBILE";

    private bool IsDetecting = true;
    private bool IsBusy;
    private bool IsLoadingRisk;
    private bool IsLoadingAgent;
    private string? Error;

    private string? DetectedCode;
    private ValidateScanResponse? Result;
    private RiskResponse? Risk;
    private AgentDecisionResponse? AgentDecision;

    private async void OnBarcodesDetected(BarcodeDetectionEventArgs e)
    {
        if (!IsDetecting || IsBusy)
            return;

        var value = e.Results?.FirstOrDefault()?.Value;

        if (string.IsNullOrWhiteSpace(value))
            return;

        DetectedCode = value.Trim();
        IsDetecting = false;
        ScanStatus = "Code detected";

        try
        {
            Vibration.Default.Vibrate(TimeSpan.FromMilliseconds(120));
        }
        catch
        {
            // Vibration may be unavailable on emulator/device.
        }

        await InvokeAsync(StateHasChanged);

        if (AutoValidate)
        {
            await ValidateDetectedAsync();
        }
    }

    private void ResumeScanning()
    {
        DetectedCode = null;
        Result = null;
        Risk = null;
        AgentDecision = null;
        Error = null;
        ScanStatus = "Ready to scan";
        IsDetecting = true;
    }

    private async Task ValidateDetectedAsync()
    {
        if (string.IsNullOrWhiteSpace(DetectedCode))
        {
            Error = "No ticket code detected.";
            return;
        }

        try
        {
            IsBusy = true;
            Error = null;
            Result = null;
            Risk = null;
            AgentDecision = null;

            Result = await Api.ValidateAsync(new ValidateScanRequest
            {
                TicketCode = DetectedCode.Trim(),
                DeviceId = DeviceId,
                GateId = GateId,
                Source = "mobile-camera",
                ScannedAtUtc = DateTime.UtcNow
            });

            if (Result is not null)
            {
                ScanStatus = Result.Accepted ? "Ticket accepted" : "Ticket rejected";
            }

            if (Result is null)
                Error = "Validation failed. Check API connection.";
        }
        catch (Exception ex)
        {
            Error = $"Validation error: {ex.Message}";
            ScanStatus = "Validation failed";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LoadRiskAsync()
    {
        if (Result is null)
            return;

        try
        {
            IsLoadingRisk = true;
            Error = null;

            var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

            Risk = await Api.GetRiskAsync(Result.ScanAttemptId, lang);

            if (Risk is null)
                Error = "AI analysis unavailable.";
        }
        catch (Exception ex)
        {
            Error = $"AI analysis error: {ex.Message}";
        }
        finally
        {
            IsLoadingRisk = false;
        }
    }

    private async Task LoadAgentAsync()
    {
        if (Result is null)
            return;

        try
        {
            IsLoadingAgent = true;
            Error = null;

            var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

            AgentDecision = await Api.AnalyzeWithAgentAsync(
                Result.ScanAttemptId,
                lang);

            if (AgentDecision is null)
                Error = "Agent analysis unavailable.";
        }
        catch (Exception ex)
        {
            Error = $"Agent error: {ex.Message}";
        }
        finally
        {
            IsLoadingAgent = false;
        }
    }
}